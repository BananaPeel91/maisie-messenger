APP_NAME="Maisie Messenger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# API Security - Generate a secure random string for this
API_KEY=your-secure-api-key-here

# Email Configuration (Gmail)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
MAIL_FROM_NAME=Maisie

# Recipient Configuration
RECIPIENT_EMAIL=mums-email@example.com
RECIPIENT_NAME=Mummy
SENDER_NAME=Maisie
